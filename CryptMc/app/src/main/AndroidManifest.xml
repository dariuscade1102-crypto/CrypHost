<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking: dashboard <-> local server, Modrinth API, tunnel agent, AI assistant calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Local Hotspot Hosting (Network tab, phone/tablet only): the
         WifiManager.startLocalOnlyHotspot API this app calls from
         network/HotspotManager.kt requires ACCESS_FINE_LOCATION as a
         platform rule, not a CryptMc choice — the app never reads GPS
         location itself. CHANGE_WIFI_STATE/ACCESS_WIFI_STATE are the
         standard pair for any Wi-Fi-state API. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Requirement #6: keep the server process alive in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Exempt the app from battery optimization so Doze doesn't stall the
         server loop; must be requested via a runtime dialog, see
         BatteryOptimizationHelper.kt -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Large file writes: worlds, mod jars, logs -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Google Sign-In (Credential Manager) needs no extra manifest
         permission beyond INTERNET above — it talks to Play Services
         directly, not a broadcast/content-provider surface. -->

    <application
        android:name=".CryptMcApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.CryptMc"
        android:usesCleartextTraffic="false"
        xmlns:tools="http://schemas.android.com/tools">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- foregroundServiceType="specialUse" is the correct Android 14
             category for "runs a user-hosted server process"; Play policy
             requires a declared reason string, set in the service. -->
        <service
            android:name=".service.ServerForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

    </application>
</manifest>
